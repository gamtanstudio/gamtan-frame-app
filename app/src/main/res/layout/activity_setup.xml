<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0807"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="감탄 액자 설정"
            android:textColor="#F2EDE4"
            android:textSize="22sp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이 액자의 토큰을 붙여넣어 주세요. 관리 화면 발급 목록의 액자 주소 뒤 ?t= 다음 값입니다."
            android:textColor="#8A7F73"
            android:textSize="13sp"
            android:paddingBottom="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="액자 토큰"
            android:textColor="#B08D57"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="여기에 토큰 붙여넣기"
            android:textColor="#F2EDE4"
            android:textColorHint="#5C544C"
            android:textSize="15sp"
            android:inputType="textNoSuggestions"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="액자 번호 / 이름 (선택)"
            android:textColor="#B08D57"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: GT-0003 따뜻한 액자"
            android:textColor="#F2EDE4"
            android:textColorHint="#5C544C"
            android:textSize="15sp"
            android:inputType="text"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="문의 연락처 (선택)"
            android:textColor="#B08D57"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: 감탄사진관 031-000-0000"
            android:textColor="#F2EDE4"
            android:textColorHint="#5C544C"
            android:textSize="15sp"
            android:inputType="text"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="화면 방향"
            android:textColor="#B08D57"
            android:textSize="13sp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/orient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">

            <RadioButton
                android:id="@+id/o_sensor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2EDE4"
                android:text="자동회전 (기기에 센서 있을 때만)" />

            <RadioButton
                android:id="@+id/o_portrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2EDE4"
                android:text="세로" />

            <RadioButton
                android:id="@+id/o_portrait_rev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2EDE4"
                android:text="세로 (뒤집힘)" />

            <RadioButton
                android:id="@+id/o_landscape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2EDE4"
                android:text="가로" />

            <RadioButton
                android:id="@+id/o_landscape_rev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2EDE4"
                android:text="가로 (뒤집힘)" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="관리자 PIN"
            android:textColor="#B08D57"
            android:textSize="13sp"
            android:paddingBottom="4dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="'안드로이드 설정'으로 나갈 때 필요한 번호. 손님이 못 빠져나가게 막아줍니다. 기본 1234 — 꼭 바꾸세요."
            android:textColor="#8A7F73"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/adminpin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: 4795"
            android:textColor="#F2EDE4"
            android:textColorHint="#5C544C"
            android:textSize="15sp"
            android:inputType="number"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="저장하고 시작" />

    </LinearLayout>
</ScrollView>
